# Opciones que Docker Compose usa en el servidor.
API_BIND_ADDRESS=127.0.0.1
API_PORT=3000
API_MEMORY_LIMIT=512m
API_CPU_LIMIT=1.0
IMAGE_TAG=latest
NODE_IMAGE=node:22-bookworm-slim

# Runtime de Express dentro del contenedor.
NODE_ENV=production
HOST=0.0.0.0
PORT=3000
API_PREFIX=/api

# Use * temporalmente o una lista separada por comas con los orígenes reales.
CORS_ORIGINS=https://erp.example.com

# Active esta opción cuando la API esté detrás de Nginx, Caddy o Traefik.
TRUST_PROXY=true

# Base MySQL heredada. Este archivo real nunca debe guardarse en Git.
LEGACY_DB_HOST=mysql.example.internal
LEGACY_DB_PORT=3306
LEGACY_DB_USER=replace_me
LEGACY_DB_PASSWORD=replace_me
LEGACY_DB_NAME=replace_me
LEGACY_DB_SSL=false
