@baseUrl = http://localhost:3000
@apiPrefix = /api
@clientId = 15331

### Obtener todos los clientes
GET {{baseUrl}}{{apiPrefix}}/accounts-receivable/clients?page=1&pageSize=25
Accept: application/json

### Buscar clientes por texto
GET {{baseUrl}}{{apiPrefix}}/accounts-receivable/clients?q=cliente&page=1&pageSize=25
Accept: application/json

### Obtener cliente por identificador
GET {{baseUrl}}{{apiPrefix}}/accounts-receivable/clients/{{clientId}}
Accept: application/json

### Obtener saldo del cliente
GET {{baseUrl}}{{apiPrefix}}/accounts-receivable/clients/{{clientId}}/balance?page=1&pageSize=25
Accept: application/json

### Obtener documentos vencidos del saldo
GET {{baseUrl}}{{apiPrefix}}/accounts-receivable/clients/{{clientId}}/balance?dueStatus=overdue&page=1&pageSize=25
Accept: application/json

### Buscar un documento en el saldo
GET {{baseUrl}}{{apiPrefix}}/accounts-receivable/clients/{{clientId}}/balance?q=FE0064618&page=1&pageSize=25
Accept: application/json

### Obtener movimientos del cliente
GET {{baseUrl}}{{apiPrefix}}/accounts-receivable/clients/{{clientId}}/movements?page=1&pageSize=25
Accept: application/json

### Obtener movimientos del cliente por periodo
GET {{baseUrl}}{{apiPrefix}}/accounts-receivable/clients/{{clientId}}/movements?dateFrom=2026-01-01&dateTo=2026-12-31&page=1&pageSize=25
Accept: application/json

### Facturas
GET {{baseUrl}}{{apiPrefix}}/accounts-receivable/clients/{{clientId}}/invoices?page=1&pageSize=25
Accept: application/json

### Pedidos - relacion
