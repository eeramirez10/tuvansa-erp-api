NODE_ENV=development
HOST=0.0.0.0
PORT=3000
API_PREFIX=/api
CORS_ORIGINS=*
TRUST_PROXY=false

# Base MySQL heredada de solo lectura.
# Nunca guardar credenciales reales en el repositorio.
LEGACY_DB_HOST=
LEGACY_DB_PORT=3306
LEGACY_DB_USER=
LEGACY_DB_PASSWORD=
LEGACY_DB_NAME=
# Reportes: archivos anuales en el mismo servidor, por ejemplo tuvansa2025.
# Se descubren como <LEGACY_DB_NAME><AAAA> y usan las mismas credenciales de lectura.
# Sólo se ofrecen si el ejercicio declarado y la estructura son compatibles.
LEGACY_DB_SSL=false

# PostgreSQL de escritura. Pegar la URL completa de Neon (con TLS).
# Si está vacía, las escrituras se rechazan; nunca se redirigen a MySQL.
# Al conectar se crean automáticamente el esquema y las migraciones de la API.
NEON_DATABASE_URL=
# Compañía activa de Omnis para editar órdenes de compra. Predeterminado: México (1).
PURCHASE_ORDER_EDIT_COMPANY_ID=1
# Accesos de compra. Usuarios Omnis, hash SHA-256, niveles A–F y permisos supplierChange o supplierChangeAction.
PURCHASE_ORDER_APPROVER_KEYS=[]
# Opcional. Códigos habilitados para la captura. El primero es el predeterminado.
# PURCHASE_ORDER_WAREHOUSES=01,11,12,13,97,99
# Opcional. Pedidos valida estos códigos en el catálogo de México (compañía 1). Predeterminado: 01.
# SALES_ORDER_WAREHOUSES=01,12
INVENTORY_MOVEMENTS_SOURCE=mysql
# ISEQ separados por comas para habilitar Clasificar en la base de pruebas PostgreSQL.
INVENTORY_CLASSIFICATION_PILOT_PRODUCTS=
# ISEQ separados por comas para habilitar Otros en la base de pruebas PostgreSQL.
INVENTORY_OTHER_DATA_PILOT_PRODUCTS=
# ISEQ separados por comas para habilitar Cambio de producto en PostgreSQL de pruebas.
INVENTORY_PRODUCT_EDIT_PILOT_PRODUCTS=
