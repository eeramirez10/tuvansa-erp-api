@baseUrl = http://localhost:3000
@apiPrefix = /api
@clientId = 15331
@temporaryClientCode = QA826

### Entrada inicial de Cuentas por Cobrar (primer cliente activo, sin COUNT)
GET {{baseUrl}}{{apiPrefix}}/accounts-receivable/clients/first
Accept: application/json

### Obtener todos los clientes
GET {{baseUrl}}{{apiPrefix}}/accounts-receivable/clients?page=1&pageSize=25
Accept: application/json

### Buscar clientes por texto
GET {{baseUrl}}{{apiPrefix}}/accounts-receivable/clients?q=cliente&page=1&pageSize=25
Accept: application/json

### Obtener cliente por identificador
GET {{baseUrl}}{{apiPrefix}}/accounts-receivable/clients/{{clientId}}
Accept: application/json

### Barra - cliente anterior
GET {{baseUrl}}{{apiPrefix}}/accounts-receivable/clients/{{clientId}}/previous
Accept: application/json

### Barra - cliente siguiente
GET {{baseUrl}}{{apiPrefix}}/accounts-receivable/clients/{{clientId}}/next
Accept: application/json

### Barra - alta de cliente temporal (ejecutar antes de cambio y baja)
# @name createTemporaryClient
POST {{baseUrl}}{{apiPrefix}}/accounts-receivable/clients
Content-Type: application/json
Accept: application/json

{
  "code": "{{temporaryClientCode}}",
  "name": "Cliente temporal desde API",
  "address": {
    "street": "Calle de prueba",
    "city": "Mexico"
  },
  "contact": {
    "email": "pruebas@tuvansa.com.mx"
  },
  "fiscal": {
    "accountingAccount": "1105001"
  },
  "terms": {
    "priceList": 1,
    "discounts": [0, 0, 0],
    "paymentTermDays": 0,
    "creditLimit": 0
  }
}

### Barra - cambio al cliente temporal creado arriba
PATCH {{baseUrl}}{{apiPrefix}}/accounts-receivable/clients/{{createTemporaryClient.response.body.$.data.id}}
Content-Type: application/json
Accept: application/json

{
  "name": "Cliente temporal editado desde API"
}

### Barra - baja del cliente temporal creado arriba
DELETE {{baseUrl}}{{apiPrefix}}/accounts-receivable/clients/{{createTemporaryClient.response.body.$.data.id}}
Accept: application/json

### Obtener saldo del cliente
GET {{baseUrl}}{{apiPrefix}}/accounts-receivable/clients/{{clientId}}/balance?page=1&pageSize=25
Accept: application/json

### Obtener documentos vencidos del saldo
GET {{baseUrl}}{{apiPrefix}}/accounts-receivable/clients/{{clientId}}/balance?dueStatus=overdue&page=1&pageSize=25
Accept: application/json

### Buscar un documento en el saldo
GET {{baseUrl}}{{apiPrefix}}/accounts-receivable/clients/{{clientId}}/balance?q=FE0064618&page=1&pageSize=25
Accept: application/json

### Obtener movimientos del cliente
GET {{baseUrl}}{{apiPrefix}}/accounts-receivable/clients/{{clientId}}/movements?page=1&pageSize=25
Accept: application/json

### Obtener movimientos del cliente por periodo
GET {{baseUrl}}{{apiPrefix}}/accounts-receivable/clients/{{clientId}}/movements?dateFrom=2026-01-01&dateTo=2026-12-31&page=1&pageSize=25
Accept: application/json

