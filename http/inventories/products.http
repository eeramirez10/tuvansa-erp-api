@baseUrl = http://localhost:3000
@apiPrefix = /api
@productId = 13288
@panelPageSize = 500
@temporaryProductCode = QAPI826

### Catalogo - todos los productos
GET {{baseUrl}}{{apiPrefix}}/inventories/products?page=1&pageSize=25
Accept: application/json

### Barra - buscar por codigo o descripcion
GET {{baseUrl}}{{apiPrefix}}/inventories/products?q=01300958&page=1&pageSize=25
Accept: application/json

### Catalogo - ficha del producto
GET {{baseUrl}}{{apiPrefix}}/inventories/products/{{productId}}
Accept: application/json

### Barra - producto anterior
GET {{baseUrl}}{{apiPrefix}}/inventories/products/{{productId}}/previous
Accept: application/json

### Barra - producto siguiente
GET {{baseUrl}}{{apiPrefix}}/inventories/products/{{productId}}/next
Accept: application/json

### Barra - alta temporal (ejecutar antes de cambio y baja)
# @name createTemporaryProduct
POST {{baseUrl}}{{apiPrefix}}/inventories/products
Content-Type: application/json
Accept: application/json

{
  "code": "{{temporaryProductCode}}",
  "description": "Producto temporal desde API",
  "classification": {
    "type": "rawMaterial",
    "unitId": 1,
    "familyCode": ""
  },
  "prices": {
    "sale": [
      { "amount": 0, "currencyId": 1 },
      { "amount": 0, "currencyId": 0 },
      { "amount": 0, "currencyId": 0 }
    ]
  },
  "warehouse": {
    "minimum": 0,
    "maximum": 0,
    "location": "",
    "ean": "",
    "upc": "",
    "accounts": {
      "primary": "",
      "secondary": "",
      "costOfSales": ""
    }
  }
}

### Barra - cambio al producto temporal
PATCH {{baseUrl}}{{apiPrefix}}/inventories/products/{{createTemporaryProduct.response.body.$.data.id}}
Content-Type: application/json
Accept: application/json

{
  "description": "Producto temporal editado desde API"
}

### Barra - baja del producto temporal
DELETE {{baseUrl}}{{apiPrefix}}/inventories/products/{{createTemporaryProduct.response.body.$.data.id}}
Accept: application/json

### Acciones - Almacenes
GET {{baseUrl}}{{apiPrefix}}/inventories/products/{{productId}}/actions/warehouses?page=1&pageSize=25

### Acciones - Alta CT
GET {{baseUrl}}{{apiPrefix}}/inventories/products/{{productId}}/actions/color-size-registration

### Acciones - Bloquear (estado)
GET {{baseUrl}}{{apiPrefix}}/inventories/products/{{productId}}/actions/block-status

### Acciones - Bloquear producto
PATCH {{baseUrl}}{{apiPrefix}}/inventories/products/{{productId}}/actions/block-status
Content-Type: application/json

{
  "blocked": true
}

### Acciones - Desbloquear producto
PATCH {{baseUrl}}{{apiPrefix}}/inventories/products/{{productId}}/actions/block-status
Content-Type: application/json

{
  "blocked": false
}

