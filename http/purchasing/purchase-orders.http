@baseUrl = http://localhost:3000/api
@purchaseOrderId = 218451
@purchaseOrderNumber = OH00205
@editOrderId = 93984
@editRevision = 0
@legacyVersion = copiar-del-GET-edit
@removalId = copiar-id-de-orden-de-prueba
@removalNumber = copiar-folio-del-GET-removal
@removalVersion = copiar-del-GET-removal
@removalRevision = 0
@confirmationId = copiar-id-de-orden-de-prueba
@confirmationVersion = copiar-version-del-GET-confirmation
@confirmationRevision = 0
@confirmationMode = confirm
@authorizationId = copiar-id-de-orden-de-prueba
@authorizationVersion = copiar-version-del-GET-authorization
@authorizationRevision = 0
@authorizationClassificationRevision = 0
@authorizationSupplierRevision = 0
@authorizationStatus =
@replacementSupplier = 30262
@supplierActionId = copiar-id-de-orden-de-prueba
@supplierActionVersion = copiar-version-del-GET-change-supplier
@supplierActionRevision = 0
@supplierActionClassificationRevision = 0
@supplierActionSupplierRevision = 0
@creationSupplier = 35436
@creationDate = 2026-11-23
@creationRequestKey = 92bc9c06-bd13-4533-9de7-d2fa4e380ae2

### Buscar órdenes de compra (modal Buscar)
GET {{baseUrl}}/purchasing/purchase-orders?orderNumber=OH&page=1&pageSize=25

### Buscar por pedido del proveedor
GET {{baseUrl}}/purchasing/purchase-orders?supplierOrderNumber=7879&page=1&pageSize=25

### Buscar por proveedor
GET {{baseUrl}}/purchasing/purchase-orders?supplierCode=30262&page=1&pageSize=25

### Cargar orden por identificador
GET {{baseUrl}}/purchasing/purchase-orders/{{purchaseOrderId}}

### Cargar orden por número
GET {{baseUrl}}/purchasing/purchase-orders/by-number/{{purchaseOrderNumber}}

### Orden anterior
GET {{baseUrl}}/purchasing/purchase-orders/{{purchaseOrderId}}/previous

### Orden siguiente
GET {{baseUrl}}/purchasing/purchase-orders/{{purchaseOrderId}}/next

### Acción: Auxiliar (Recepciones de O.C.)
GET {{baseUrl}}/purchasing/purchase-orders/{{purchaseOrderId}}/actions/auxiliar

### Acción: Clasificar
GET {{baseUrl}}/purchasing/purchase-orders/{{purchaseOrderId}}/actions/classifications

### Acción: Confirmar todo o desconfirmar (Shift + clic)
GET {{baseUrl}}/purchasing/purchase-orders/{{confirmationId}}/actions/confirmation

### Acción: Sí (usa mode=confirm o mode=unconfirm)
PATCH {{baseUrl}}/purchasing/purchase-orders/{{confirmationId}}/actions/confirmation
Content-Type: application/json

{
  "mode": "{{confirmationMode}}",
  "revision": {{confirmationRevision}},
  "legacyVersion": "{{confirmationVersion}}"
}

### Acción: Autorizar / consultar niveles y estado
GET {{baseUrl}}/purchasing/purchase-orders/{{authorizationId}}/actions/authorization

### Autorizar / Cambia proveedor / Buscar
GET {{baseUrl}}/purchasing/purchase-orders/authorization/suppliers?code={{replacementSupplier}}

### Acciones / Cambia Prv / consultar proveedor actual y revisiones
GET {{baseUrl}}/purchasing/purchase-orders/{{supplierActionId}}/actions/change-supplier

### Acciones / Cambia Prv / OK (PostgreSQL de pruebas)
# Copia las cuatro versiones/revisiones del GET y usa la clave con supplierChangeAction.
PATCH {{baseUrl}}/purchasing/purchase-orders/{{supplierActionId}}/actions/change-supplier
Authorization: Bearer {{$processEnv PURCHASE_ORDER_APPROVAL_TEST_KEY}}
Content-Type: application/json

{
  "supplierCode": "{{replacementSupplier}}",
  "revision": {{supplierActionRevision}},
  "classificationRevision": {{supplierActionClassificationRevision}},
  "supplierRevision": {{supplierActionSupplierRevision}},
  "legacyVersion": "{{supplierActionVersion}}"
}

### Autorizar / Cambia proveedor / OK (PostgreSQL de pruebas)
# Usa una orden de prueba en 9A con proveedor COMPRA y la clave de un usuario con supplierChange.
# Copia las versiones/revisiones del GET de Autorizar. supplierRevision viene en supplierChange.
PATCH {{baseUrl}}/purchasing/purchase-orders/{{authorizationId}}/actions/authorization/supplier
Authorization: Bearer {{$processEnv PURCHASE_ORDER_APPROVAL_TEST_KEY}}
Content-Type: application/json

{
  "supplierCode": "{{replacementSupplier}}",
  "revision": {{authorizationRevision}},
  "classificationRevision": {{authorizationClassificationRevision}},
  "supplierRevision": {{authorizationSupplierRevision}},
  "legacyVersion": "{{authorizationVersion}}"
}

### Acción: O.K. A (usa direction=approve o revoke)
# Define PURCHASE_ORDER_APPROVAL_TEST_KEY fuera del repositorio y copia la versión y revisiones del GET.
PATCH {{baseUrl}}/purchasing/purchase-orders/{{authorizationId}}/actions/authorization
Authorization: Bearer {{$processEnv PURCHASE_ORDER_APPROVAL_TEST_KEY}}
Content-Type: application/json

{
  "level": "A",
  "direction": "approve",
  "status": "{{authorizationStatus}}",
  "revision": {{authorizationRevision}},
  "classificationRevision": {{authorizationClassificationRevision}},
  "legacyVersion": "{{authorizationVersion}}"
}

### Acción: Comentarios
GET {{baseUrl}}/purchasing/purchase-orders/{{purchaseOrderId}}/actions/comments

### Acción: CT (consulta de color y talla)
GET {{baseUrl}}/purchasing/purchase-orders/{{purchaseOrderId}}/actions/ct

### Acción: Piezas
GET {{baseUrl}}/purchasing/purchase-orders/{{purchaseOrderId}}/actions/pieces

### Lápiz: abrir Cambio de orden de compra
GET {{baseUrl}}/purchasing/purchase-orders/{{editOrderId}}/edit

### Papelera: consultar si se puede dar de baja una orden
GET {{baseUrl}}/purchasing/purchase-orders/{{removalId}}/removal

### Papelera: confirmar baja en PostgreSQL de pruebas
# Sustituye el ID por una orden de prueba y copia folio, revisión y versión del GET.
DELETE {{baseUrl}}/purchasing/purchase-orders/{{removalId}}
Content-Type: application/json

{
  "number": "{{removalNumber}}",
  "revision": {{removalRevision}},
  "legacyVersion": "{{removalVersion}}"
}

### Cambio de orden de compra: validar el producto o buscar por descripción
GET {{baseUrl}}/purchasing/purchase-orders/{{editOrderId}}/edit/products?q=01202259

### Cambio de orden de compra: OK (PostgreSQL)
# Copia la revisión, legacyVersion y las partidas del GET edit. El ejemplo conserva O000001.
PATCH {{baseUrl}}/purchasing/purchase-orders/{{editOrderId}}
Content-Type: application/json

{
  "revision": {{editRevision}},
  "legacyVersion": "{{legacyVersion}}",
  "removeZero": false,
  "lines": [
    {
      "id": 364375,
      "productCode": "01202259",
      "quantity": 5,
      "unit": "PZ",
      "discount": 0,
      "price": 0,
      "branch": 0,
      "pieces": ""
    }
  ]
}

### Acción: Guardar Clasificar (PostgreSQL de pruebas)
# El ejemplo conserva los valores de la orden OH00205 con revisión 0 del ejemplo.
# Para guardar otro cambio toma current y revision del GET y cambia sólo el AGTNUM deseado.
PATCH {{baseUrl}}/purchasing/purchase-orders/{{purchaseOrderId}}/actions/classifications
Content-Type: application/json

{
  "current": ["1", "", "", "", "", "", "", "", ""],
  "revision": 0
}

### Hoja: abrir Nueva orden de compra
# Devuelve almacén predeterminado, lista de almacenes y si se debe abrir el selector.
GET {{baseUrl}}/purchasing/purchase-orders/create

### Nueva orden: proveedor por código o nombre
GET {{baseUrl}}/purchasing/purchase-orders/create/suppliers?q={{creationSupplier}}

### Nueva orden: producto por código o descripción para el proveedor seleccionado
GET {{baseUrl}}/purchasing/purchase-orders/create/products?supplierCode={{creationSupplier}}&q=01300958

### Nueva orden: OK (crea una orden en PostgreSQL de pruebas)
# Usa las fechas y un código de la lista de almacenes del GET /create.
# Cambia el UUID para cada alta y consérvalo al reintentarlo.
POST {{baseUrl}}/purchasing/purchase-orders
Content-Type: application/json

{
  "requestKey": "{{creationRequestKey}}",
  "supplierCode": "{{creationSupplier}}",
  "supplierOrderNumber": "PRUEBA-ALTA",
  "orderedAt": "{{creationDate}}",
  "from": "{{creationDate}}",
  "dueAt": "{{creationDate}}",
  "warehouse": "01",
  "agent": "",
  "discountPercentages": [0, 0, 0],
  "taxPercentage": 16,
  "freight": 0,
  "insurance": 0,
  "other": 0,
  "otherLabel": "",
  "onAccount": 0,
  "lines": [
    { "id": null, "productCode": "01300958", "quantity": 2, "unit": "M", "discount": 0, "price": 100, "branch": 0, "pieces": "2 DE 1" }
  ]
}
